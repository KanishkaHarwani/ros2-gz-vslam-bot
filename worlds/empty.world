<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="empty">

    <!-- ============================================================ -->
    <!-- Required system plugins.                                      -->
    <!-- Fortress note: as soon as ANY plugin is declared in a world,   -->
    <!-- the automatic default-plugin loading stops, so every system   -->
    <!-- the simulation needs (physics, sensors, spawning, TF/pose      -->
    <!-- broadcasting) has to be listed explicitly below.               -->
    <!-- ============================================================ -->

    <plugin
      filename="libignition-gazebo-physics-system.so"
      name="ignition::gazebo::systems::Physics">
    </plugin>

    <plugin
      filename="libignition-gazebo-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <!-- Reverted to ogre2 — legacy ogre failed to render the robot's
           STL meshes/materials correctly at all (near-blank frames with
           fragmented uncolored geometry), a worse failure than the
           original intermittent motion-triggered corruption on ogre2.
           Sticking with ogre2 and pursuing other mitigations instead. -->
      <render_engine>ogre2</render_engine>
      <!-- Forces the render thread to stay synchronized with the physics
           thread on every step, instead of rendering asynchronously.
           Without this, GPU sensors (rgbd_camera, gpu_lidar) attached to
           a moving link can grab a partially-updated frame buffer while
           the link's pose is changing mid-render, producing torn/partial
           images — clean while stationary, corrupted once the robot moves.
           This is the documented fix for that failure mode. -->
      <lockstep>true</lockstep>
    </plugin>

    <plugin
      filename="libignition-gazebo-scene-broadcaster-system.so"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="libignition-gazebo-user-commands-system.so"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- ============================================================ -->
    <!-- Lighting                                                       -->
    <!-- ============================================================ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ============================================================ -->
    <!-- Ground plane                                                   -->
    <!-- ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
