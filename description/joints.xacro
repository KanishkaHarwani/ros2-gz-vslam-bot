<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- =========================================== -->
    <!-- ================ WHEEL JOINTS ============= -->
    <!-- =========================================== -->
    <joint name="l_f_wheel_joint" type="continuous">
        <origin xyz="0.45 0.325 0.225" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="l_f_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <joint name="l_r_wheel_joint" type="continuous">
        <origin xyz="-0.45 0.325 0.225" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="l_r_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <joint name="r_r_wheel_joint" type="continuous">
        <origin xyz="-0.45 -0.325 0.225" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="r_r_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <joint name="r_f_wheel_joint" type="continuous">
        <origin xyz="0.45 -0.325 0.225" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="r_f_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <!-- =========================================== -->
    <!-- ================ BUMPER JOINTS ============ -->
    <!-- =========================================== -->
    <joint name="front_bumper_joint" type="fixed">
        <origin xyz="0.7 0.225 0.45" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="front_bumper_link"/>
    </joint>

    <!-- Mirrors front_bumper_joint across the YZ plane (X negated) to
         counterbalance the front bumper's mass and pull the whole-robot
         center of mass back toward base_link's origin. -->
    <joint name="rear_bumper_joint" type="fixed">
        <origin xyz="-0.7 0.225 0.45" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rear_bumper_link"/>
    </joint>

    <!-- =========================================== -->
    <!-- ================ CAMERA JOINTS ============ -->
    <!-- =========================================== -->
    <joint name="f_rgbd_joint" type="fixed">
        <origin xyz="0.6525 0.0 0.705" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="f_rgbd_link"/>
    </joint>

    <joint name="r_rgbd_joint" type="fixed">
        <origin xyz="-0.6525 0.0 0.705" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="r_rgbd_link"/>
    </joint>

    <!-- =========================================== -->
    <!-- ================ LIDAR JOINTS ============= -->
    <!-- =========================================== -->
    <joint name="f_lidar_joint" type="fixed">
        <origin xyz="0.58 0.0 0.785" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="f_lidar_link"/>
    </joint>

    <joint name="r_lidar_joint" type="fixed">
        <origin xyz="-0.58 0.0 0.785" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="r_lidar_link"/>
    </joint>

</robot>
