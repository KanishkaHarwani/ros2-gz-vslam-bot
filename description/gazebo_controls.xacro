<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">

            <!-- Wheel joints: two per side for the 4-wheel skid-steer -->
            <left_joint>l_f_wheel_joint</left_joint>
            <left_joint>l_r_wheel_joint</left_joint>
            <right_joint>r_f_wheel_joint</right_joint>
            <right_joint>r_r_wheel_joint</right_joint>

            <!-- Wheel geometry -->
            <wheel_separation>0.65</wheel_separation>
            <wheel_radius>0.075</wheel_radius>

            <!-- Output -->
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>

        </plugin>
    </gazebo>

</robot>
