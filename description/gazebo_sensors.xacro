<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- =========================================== -->
    <!-- ========== FRONT CAMERA SENSORS ============ -->
    <!-- =========================================== -->
    <!-- Split into two separate sensors instead of one combined rgbd_camera.
         This exercises different gz-sensors code (CameraSensor / DepthCameraSensor)
         than the combined RgbdCameraSensor implementation, which showed
         intermittent frame corruption on ogre2 during robot motion
         (matches gazebosim/ros_gz#738, closed upstream with no fix).
         Trade-off: no fused colored point cloud output anymore — if your
         VSLAM framework needs that, this will need revisiting. Frameworks
         that sync separate RGB + depth + camera_info topics (e.g. RTAB-Map)
         are unaffected. -->
    <gazebo reference="f_rgbd_link">
        <sensor name="front_camera" type="camera">
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>camera/front/image</topic>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
                <camera_info_topic>camera/front/camera_info</camera_info_topic>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="f_rgbd_link">
        <sensor name="front_depth_camera" type="depth_camera">
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>camera/front/depth_image</topic>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <!-- =========================================== -->
    <!-- =========== REAR CAMERA SENSORS ============ -->
    <!-- =========================================== -->
    <gazebo reference="r_rgbd_link">
        <sensor name="rear_camera" type="camera">
            <update_rate>20</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <topic>camera/rear/image</topic>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
                <camera_info_topic>camera/rear/camera_info</camera_info_topic>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="r_rgbd_link">
        <sensor name="rear_depth_camera" type="depth_camera">
            <update_rate>20</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <topic>camera/rear/depth_image</topic>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

