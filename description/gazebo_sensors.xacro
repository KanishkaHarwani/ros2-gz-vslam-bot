<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- =========================================== -->
    <!-- ========== FRONT CAMERA SENSOR ============ -->
    <!-- =========================================== -->
    <gazebo reference="f_rgbd_link">
        <sensor name="front camera" type="depth">
            <update_rate>20</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_optical_frame</frame_name>
                <min_depth>0.1</min_depth>
                <max_depth>8.0</max_depth>
            </plugin>
        </sensor>
    </gazebo>

    <!-- =========================================== -->
    <!-- =========== REAR CAMERA SENSOR ============ -->
    <!-- =========================================== -->
    <gazebo reference="r_rgbd_link">
        <sensor name="rear camera" type="depth">
            <update_rate>20</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_optical_frame</frame_name>
                <min_depth>0.1</min_depth>
                <max_depth>8.0</max_depth>
            </plugin>
        </sensor>
    </gazebo>
</robot>
